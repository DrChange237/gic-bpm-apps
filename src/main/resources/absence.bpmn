          <camunda:formField id="reason" label="Motif de l&#39;absence" type="string">
            <camunda:properties>
              <camunda:property id="fieldType" value="field" />
              <camunda:property id="type" value="choice" />
              <camunda:property id="required" value="true" />
              <camunda:property id="choices" value="[{&#34;label&#34;:&#34;Mariage&#34;,&#34;value&#34;:&#34;MARIAGE&#34;},{&#34;label&#34;:&#34;Baptème&#34;,&#34;value&#34;:&#34;BAPTEME&#34;},{&#34;label&#34;:&#34;Autres&#34;,&#34;value&#34;:&#34;OTHER&#34;}]" />
