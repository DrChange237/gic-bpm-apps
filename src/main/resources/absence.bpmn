              <camunda:property id="required" value="true" />
            </camunda:properties>
          </camunda:formField>
          <camunda:formField id="days" label="Nombre de jours souhaité" type="long">
            <camunda:properties>
              <camunda:property id="fieldType" value="field" />
              <camunda:property id="type" value="number" />
              <camunda:property id="required" value="false" />
            </camunda:properties>
          </camunda:formField>
          <camunda:formField id="reason" label="Motif de l&#39;absence" type="string">
            <camunda:properties>
              <camunda:property id="fieldType" value="field" />
              <camunda:property id="type" value="choice" />
              <camunda:property id="required" value="true" />
              <camunda:property id="choices" value="[   {&#34;label&#34;:&#34;Mariage (5 Jours)&#34;,&#34;value&#34;:&#34;MARIAGE&#34;},          {&#34;label&#34;:&#34;Accouchement de l&#39;épouse (3 Jours)&#34;,&#34;value&#34;:&#34;ACCOUCHEMENT&#34;},          {&#34;label&#34;:&#34;Baptème d&#39;un enfant (2 Jours)&#34;,&#34;value&#34;:&#34;BAPTEME&#34;},          {&#34;label&#34;:&#34;Première communion d&#39;un enfant (1 Jour)&#34;,&#34;value&#34;:&#34;COMMUNION&#34;},          {&#34;label&#34;:&#34;Mariage d&#39;un enfant (2 Jours)&#34;,&#34;value&#34;:&#34;MARIAGE_ENFANT&#34;},          {&#34;label&#34;:&#34;Déces Conjoint (5 Jours)&#34;,&#34;value&#34;:&#34;DECES_CONJOINT&#34;},          {&#34;label&#34;:&#34;Déces d&#39;un enfant (3 Jours)&#34;,&#34;value&#34;:&#34;DECES_ENFANT&#34;},          {&#34;label&#34;:&#34;Déces d&#39;un parent (3 Jours)&#34;,&#34;value&#34;:&#34;DECES_PARENT&#34;},          {&#34;label&#34;:&#34;Déces d&#39;un frère ou d&#39;une soeur (2 Jours)&#34;,&#34;value&#34;:&#34;DECES_FRERE&#34;},       {&#34;label&#34;:&#34;Déménagement Travailleur (2 Jours)&#34;,&#34;value&#34;:&#34;DEMENAGEMENT&#34;},         {&#34;label&#34;:&#34;Autres (A Préciser)&#34;,&#34;value&#34;:&#34;OTHER&#34;}  ]" />
            </camunda:properties>
          </camunda:formField>
          <camunda:formField id="endDate" label="Date de reprise de Service" type="date">
            <camunda:properties>
              <camunda:property id="fieldType" value="field" />
              <camunda:property id="type" value="date" />
              <camunda:property id="required" value="true" />
            </camunda:properties>
          </camunda:formField>
          <camunda:formField id="otherReason" label="Autres Raisons" type="string">
            <camunda:properties>
              <camunda:property id="fieldType" value="field" />
              <camunda:property id="type" value="text" />
              <camunda:property id="required" value="false" />
              <camunda:property id="description" value="Si la raison n&#39;est pas conventionelle veuillez la préciser ici" />
            </camunda:properties>
            <camunda:validation />
          </camunda:formField>
          <camunda:formField id="plusDays" label="Jours en plus" type="long" defaultValue="0">
            <camunda:properties>
              <camunda:property id="fieldType" value="field" />
              <camunda:property id="type" value="number" />
              <camunda:property id="required" value="false" />
              <camunda:property id="description" value="Si vous voulez ajouter des jours à une raison conventionnelle" />
              <camunda:property id="ngIf" value="reason != &#34;OTHER&#34;" />
            </camunda:properties>
          </camunda:formField>
          <camunda:formField id="interim" label="Proposition D&#39;intérimaire" type="string">
            <camunda:properties>
              <camunda:property id="fieldType" value="field" />
              <camunda:property id="type" value="Employee" />
              <camunda:property id="required" value="false" />
