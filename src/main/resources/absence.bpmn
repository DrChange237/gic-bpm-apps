              <camunda:property id="required" value="false" />
              <camunda:property id="description" value="Si la raison n&#39;est pas conventionelle veuillez la préciser ici" />
            </camunda:properties>
            <camunda:validation />
          </camunda:formField>
          <camunda:formField id="plusDays" label="Jours en plus" type="long" defaultValue="0">
            <camunda:properties>
              <camunda:property id="fieldType" value="field" />
              <camunda:property id="type" value="number" />
              <camunda:property id="required" value="false" />
              <camunda:property id="description" value="Si vous voulez ajouter des jours à une raison conventionnelle" />
              <camunda:property id="ngIf" value="reason != &#34;OTHER&#34;" />
