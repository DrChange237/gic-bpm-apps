              <camunda:property id="type" value="text" />
              <camunda:property id="required" value="false" />
            </camunda:properties>
          </camunda:formField>
        </camunda:formData>
        <camunda:executionListener delegateExpression="${startResumptionListener}" event="start" />
      </bpmn:extensionElements>
