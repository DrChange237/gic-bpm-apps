<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0khnz3s" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.38.1" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.19.0">
  <bpmn:process id="equivalence" name="Equivalence de Diplômes" isExecutable="true">
    <bpmn:startEvent id="start_equivalence" name="Initiation des Equivalences">
      <bpmn:outgoing>Flow_1msxvmh</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1msxvmh" sourceRef="start_equivalence" targetRef="Activity_1oeg2vr" />
    <bpmn:userTask id="upload_diploma" name="Upload des Diplômes / Prendre" camunda:formRef="take-diploma-form" camunda:formRefBinding="latest" camunda:candidateGroups="equivalence,admin">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${takeDiplomaListener}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0wwx3ak</bpmn:incoming>
      <bpmn:outgoing>Flow_1n55a1p</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="create_equivalence_profil" name="Creation de Profil auprès de l&#39;organisme d&#39;Equivalence" camunda:candidateGroups="equivalence,admin">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${equivalenceProfilListener}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1n55a1p</bpmn:incoming>
      <bpmn:outgoing>Flow_1sff46j</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_0u1grab" name="Fin des Equivalences">
      <bpmn:incoming>Flow_1ly476m</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1sff46j" sourceRef="create_equivalence_profil" targetRef="certify_diploma" />
    <bpmn:sequenceFlow id="Flow_0llypan" sourceRef="certify_diploma" targetRef="Event_1fdaocg" />
    <bpmn:userTask id="certify_diploma" name="Certification/Authentification du Diplôme" camunda:candidateGroups="equivalence,admin">
      <bpmn:incoming>Flow_1sff46j</bpmn:incoming>
      <bpmn:incoming>Flow_04mdqe3</bpmn:incoming>
      <bpmn:incoming>Flow_0xrenks</bpmn:incoming>
      <bpmn:outgoing>Flow_0llypan</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1q3s5d5" sourceRef="Gateway_1fewf2y" targetRef="authentification_diploma">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reason=="authentification"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="authentification_diploma" name="Authentification du Diplôme" camunda:candidateGroups="equivalence,admin">
      <bpmn:incoming>Flow_1q3s5d5</bpmn:incoming>
      <bpmn:outgoing>Flow_0xrenks</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0xrenks" sourceRef="authentification_diploma" targetRef="certify_diploma" />
    <bpmn:sequenceFlow id="Flow_0ft1pvi" sourceRef="Gateway_1fewf2y" targetRef="missing_element_equivalence">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reason=="missing"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="missing_element_equivalence" name="Manquement sur Dossier Equivalence" camunda:candidateGroups="equivalence,admin">
      <bpmn:incoming>Flow_0ft1pvi</bpmn:incoming>
      <bpmn:outgoing>Flow_04mdqe3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_04mdqe3" sourceRef="missing_element_equivalence" targetRef="certify_diploma" />
    <bpmn:exclusiveGateway id="Gateway_02hm1we" default="Flow_1icn8q6">
      <bpmn:incoming>Flow_0ow5fgc</bpmn:incoming>
      <bpmn:outgoing>Flow_1uuc3x0</bpmn:outgoing>
      <bpmn:outgoing>Flow_1icn8q6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0ow5fgc" sourceRef="Event_1fdaocg" targetRef="Gateway_02hm1we" />
    <bpmn:sequenceFlow id="Flow_1uuc3x0" sourceRef="Gateway_02hm1we" targetRef="Activity_0y0n3qn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reason=="complete"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1icn8q6" sourceRef="Gateway_02hm1we" targetRef="Gateway_1fewf2y" />
    <bpmn:sequenceFlow id="Flow_0wwx3ak" sourceRef="Activity_1oeg2vr" targetRef="upload_diploma" />
    <bpmn:sequenceFlow id="Flow_1n55a1p" sourceRef="upload_diploma" targetRef="create_equivalence_profil" />
    <bpmn:intermediateCatchEvent id="Event_1fdaocg" name="Notification Organisme Equivalence">
      <bpmn:incoming>Flow_0llypan</bpmn:incoming>
      <bpmn:outgoing>Flow_0ow5fgc</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0g8oij3" messageRef="Message_23a111c" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_1ly476m" sourceRef="Activity_0y0n3qn" targetRef="Event_0u1grab" />
    <bpmn:sendTask id="Activity_1oeg2vr" name="Notification d&#39;apport des relevés de notes et Attestations" camunda:delegateExpression="${notifCustomer}">
      <bpmn:incoming>Flow_1msxvmh</bpmn:incoming>
      <bpmn:outgoing>Flow_0wwx3ak</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_1fewf2y">
      <bpmn:incoming>Flow_1icn8q6</bpmn:incoming>
      <bpmn:outgoing>Flow_1q3s5d5</bpmn:outgoing>
      <bpmn:outgoing>Flow_0ft1pvi</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_0y0n3qn" name="Notifier le Client" camunda:delegateExpression="${notifCustomer}">
      <bpmn:incoming>Flow_1uuc3x0</bpmn:incoming>
      <bpmn:outgoing>Flow_1ly476m</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
